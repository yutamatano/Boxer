+size_t System::SaveNeonMapPoints(const string &filename)
+{
+    // SaveNeonCameraTrajectory must first stop and join all writers.
+    if (!isShutDown() || !mpLocalMapper->isFinished()
+        || !mpLoopCloser->isFinished() || mpLoopCloser->isRunningGBA())
+        throw std::runtime_error("Export trajectory before map points");
+    ofstream out(filename);
+    if (!out) throw std::runtime_error("Cannot write Neon map points");
+    out << "map_id,point_id,x,y,z,observations\n" << setprecision(17);
+    size_t count = 0;
+    for (Map* map : mpAtlas->GetAllMaps())
+    {
+        if (!map || !map->isImuInitialized()) continue;
+        for (MapPoint* point : map->GetAllMapPoints())
+        {
+            if (!point || point->isBad() || point->Observations() < 3) continue;
+            const auto p = point->GetWorldPos();
+            if (!p.allFinite()) continue;
+            out << map->GetId() << ',' << point->mnId << ',' << p.x() << ','
+                << p.y() << ',' << p.z() << ',' << point->Observations() << '\n';
+            ++count;
+        }
+    }
+    return count;
 }

